# .gitignore globale per Synapse-Data-Platform

# Ignora i file di configurazione degli editor più comuni a livello di root
.vscode/
.idea/

# File di sistema operativo
.DS_Store
Thumbs.db

# File di log
*.log

# ==================================
# BACKEND - sdp-api (Python/FastAPI)
# ==================================
sdp-api/.venv/
# Bytecode Python a qualsiasi livello: le regole precedenti coprivano solo
# sdp-api/__pycache__/, non le sottocartelle tipo sdp-api/api/__pycache__/.
__pycache__/
*.pyc
*.pyo
sdp-api/.env
sdp-api/database.db
sdp-api/dist
sdp-api/build
sdp-api/sdp-api.egg-info
Nuova cartella
.claude
venv
# ===================================
# FRONTEND - sdp-app (Tauri/React)
# ===================================
# Dipendenze Node
sdp-app/node_modules/
sdp-app/src-tauri/Cargo.toml
# File di build di Vite/React
sdp-app/dist/
sdp-app/build/

# File di build e cache di Tauri/Rust
sdp-app/src-tauri/target/
sdp-app/src-tauri/gen/
sdp-app/src-tauri/Cargo.lock

# Binari backend (troppo grandi per GitHub)
sdp-app/src-tauri/binaries/*.exe

# Log di NPM
sdp-app/npm-debug.log*
sdp-app/yarn-debug.log*
sdp-app/yarn-error.log*